{
  "name": "digital-barbershop-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@digital-barbershop/web",
    "dev:mobile": "turbo run dev --filter=@digital-barbershop/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "metro": "~0.83.0",
    "metro-cache": "~0.83.0",
    "metro-cache-key": "~0.83.0",
    "metro-config": "~0.83.0",
    "metro-core": "~0.83.0",
    "metro-runtime": "~0.83.0"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "~5.8.3"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
